<?xml version="1.0"?>
<!--
/**
 * @author Devendra Gupta
 * @package Devendra_CurrencyConverter
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <head>
        <title>Currency Exchange Converter</title>
        <css src="Devendra_CurrencyConverter::css/converter.css"/>
    </head>

    <body>
        <referenceContainer name="content">
            <block
                class="Magento\Framework\View\Element\Template"
                name="currency.converter"
                template="Devendra_CurrencyConverter::converter.phtml">
                    <referenceBlock name="currency.converter">
                        <arguments>
                            <argument name="view_model" xsi:type="object">
                                Devendra\CurrencyConverter\ViewModel\Data
                            </argument>
                        </arguments>
                    </referenceBlock>
                </block>
        </referenceContainer>
    </body>
</page>